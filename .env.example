# ── Wanasanaa API ─────────────────────────────────────────────────────────────
PORT=4000
APP_URL=http://localhost:4000
NODE_ENV=development

# PostgreSQL (the local dev cluster from `npm run db:start` listens on 5433)
DATABASE_URL=postgres://postgres@127.0.0.1:5433/wanasanaa

# Sessions
JWT_SECRET=dev-only-secret-please-generate-a-32-byte-random-value

# Marketplace
PLATFORM_COMMISSION_RATE=0.12
SHIPPING_FEE_KES=0

# ── Safaricom M-Pesa (Daraja) ────────────────────────────────────────────────
# Leave these empty to run in simulation mode: STK Push responses are mocked so
# the full checkout can be tested locally. Fill them in for the real sandbox or
# production, with a public HTTPS callback URL.
MPESA_ENV=sandbox
MPESA_BASE_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# MPESA_SIMULATE=true
