{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "listening on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "API tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tests/api.test.js",
      "runtimeArgs": ["--test", "--test-concurrency=1"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Set up database",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/db-setup.mjs",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
