{
  "name": "wanasanaa-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Wanasanaa Contemporary artist marketplace API — PostgreSQL, KES earnings, M-Pesa STK Push.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:start": "node scripts/start-db.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:reset": "node scripts/db-setup.mjs --reset",
    "test": "node --test --test-concurrency=1 ./tests/api.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
